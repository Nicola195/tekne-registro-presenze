# ------------------------------------------------------------------
# Variabili d'ambiente — Registro Ore TEKNE (Supabase)
# ------------------------------------------------------------------
# Copiare questo file in ".env" e valorizzare i due campi.
# Su Netlify: Site settings > Environment variables (stessi due nomi).
# NON committare mai il file ".env" con i valori reali (è già in .gitignore).
# ------------------------------------------------------------------

# URL del progetto Supabase (es. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chiave "publishable" del progetto Supabase (sb_publishable_...).
# È pubblica per natura: sicura nel browser perché i dati sono protetti
# dalle policy Row-Level Security. NON usare mai la chiave "secret".
VITE_SUPABASE_PUBLISHABLE_KEY=
