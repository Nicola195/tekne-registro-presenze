# ------------------------------------------------------------------
# Variabili d'ambiente — Registro Ore TEKNE
# ------------------------------------------------------------------
# La versione STATICA attuale NON usa queste variabili: i dati sono
# salvati nel localStorage del browser. Questo file serve da modello
# per la futura migrazione a Supabase (login + database condiviso).
#
# Copiare in ".env" e valorizzare SOLO quando si attiva Supabase.
# Su Netlify, impostarle in: Site settings > Environment variables.
# ------------------------------------------------------------------

# URL del progetto Supabase (es. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chiave pubblica "anon" del progetto Supabase
VITE_SUPABASE_ANON_KEY=
